+/* Haunted Browser — scoped spectral chrome so BSC's global theme stays intact. */
+.haunted-browser {
+  --hb-bg: #0a0918;
+  --hb-fg: #e8eef8;
+  --hb-muted: #8b93b0;
+  --hb-primary: #4aded0;
+  --hb-primary-fg: #071016;
+  --hb-card: #12101f;
+  --hb-border: #2a2540;
+  --hb-sidebar: #0e0c1c;
+  --hb-accent: #1c1830;
+  --hb-danger: #f07178;
+  color: var(--hb-fg);
+  background:
+    radial-gradient(ellipse 80% 50% at 50% -10%, rgba(74, 50, 140, 0.22), transparent),
+    radial-gradient(ellipse 50% 50% at 0% 100%, rgba(26, 140, 120, 0.12), transparent),
+    var(--hb-bg);
+  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
+}
+
+.haunted-browser .hb-glass {
+  background: color-mix(in srgb, var(--hb-card) 72%, transparent);
+  backdrop-filter: blur(14px) saturate(140%);
+  -webkit-backdrop-filter: blur(14px) saturate(140%);
+}
+
+.haunted-browser .hb-glass-strong {
+  background: color-mix(in srgb, var(--hb-card) 88%, transparent);
+  backdrop-filter: blur(20px) saturate(150%);
+  -webkit-backdrop-filter: blur(20px) saturate(150%);
+}
+
+.haunted-browser .hb-glow {
+  box-shadow:
+    0 0 0 1px color-mix(in srgb, var(--hb-primary) 30%, transparent),
+    0 0 24px -4px color-mix(in srgb, var(--hb-primary) 45%, transparent);
+}
+
+.haunted-browser .hb-text-glow {
+  text-shadow: 0 0 18px color-mix(in srgb, var(--hb-primary) 50%, transparent);
+}
+
+@keyframes hb-float {
+  0%, 100% { transform: translateY(0) rotate(-2deg); }
+  50% { transform: translateY(-6px) rotate(2deg); }
+}
+.haunted-browser .hb-float {
+  animation: hb-float 4s ease-in-out infinite;
+}
+
+@keyframes hb-pulse {
+  0%, 100% { opacity: 0.85; transform: scale(1); }
+  50% { opacity: 1; transform: scale(1.04); }
+}
+.haunted-browser .hb-pulse {
+  animation: hb-pulse 2.4s ease-in-out infinite;
+}
+
+@keyframes hb-blink {
+  0%, 80%, 100% { opacity: 0.25; }
+  40% { opacity: 1; }
+}
+.haunted-browser .hb-dot {
+  animation: hb-blink 1.3s infinite ease-in-out;
+}
+
+.haunted-browser .hb-scroll::-webkit-scrollbar {
+  width: 10px;
+  height: 10px;
+}
+.haunted-browser .hb-scroll::-webkit-scrollbar-track {
+  background: transparent;
+}
+.haunted-browser .hb-scroll::-webkit-scrollbar-thumb {
+  background: color-mix(in srgb, var(--hb-fg) 18%, transparent);
+  border-radius: 9999px;
+  border: 2px solid transparent;
+  background-clip: content-box;
+}
+
+.haunted-browser webview {
+  display: inline-flex;
+  width: 100%;
+  height: 100%;
+  border: 0;
+  background: #fff;
+}
